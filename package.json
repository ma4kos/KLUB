{
  "name": "klub-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "playwright test",
    "test:local": "playwright test --project=desktop-chrome --project=breakpoints --project=checks",
    "test:a11y": "playwright test --project=a11y",
    "test:fast": "BASE_URL=http://localhost:4321 playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:install": "playwright install --with-deps chromium firefox webkit"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.3.2"
  }
}
