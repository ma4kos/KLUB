# Copy this file to .env.klub-cy.local in the KLUB repository.
# Never commit the local file. The one-shot prompt must verify it is ignored.

# Required Wix target lock.
WIX_ACCOUNT_ID=8372deba-8664-4ad5-8212-6c10a7f348b1
WIX_SITE_ID=20f11f6f-6ce3-469d-b44c-df397c750848
WIX_SITE_NAME=KLUB-CY

# Required secret location. Keep the supplied key outside Git.
WIX_API_KEY_FILE=.secrets/WixAPIKey.txt

# Required source and preview verification.
KLUB_SOURCE_REPO=https://github.com/ma4kos/KLUB
KLUB_PINNED_COMMIT=15ec3d93f187f5ec12bee14e8bd7b11692220002
KLUB_NETLIFY_PREVIEW_URL=https://klub-cy.netlify.app/
KLUB_NETLIFY_PASSWORD=

# Required before Headless redirect/domain configuration.
# Set this manually to the custom domain currently attached to KLUB-CY.
WIX_MAIN_DOMAIN=
# Recommended pattern after WIX_MAIN_DOMAIN is known, for example checkout.example.com.
WIX_BACKEND_SUBDOMAIN=
# Created by the workflow if none exists and writes are enabled; never a secret.
PUBLIC_WIX_HEADLESS_CLIENT_ID=

# Independent operation gates. Start false.
KLUB_ALLOW_WIX_WRITES=false
KLUB_ALLOW_NETLIFY_PRODUCTION_DEPLOY=false
KLUB_ALLOW_DOMAIN_CUTOVER=false

# Optional staged-write controls. The recommended first run keeps the domain cutover false.
KLUB_CREATE_WIX_SITE_DUPLICATE=false
KLUB_CREATE_CMS_BACKUP=true
KLUB_PROVISION_HEADLESS_CLIENT=true
KLUB_PROVISION_CMS=true
KLUB_MIGRATE_FORMS=true
KLUB_MIGRATE_MEDIA=false

# Optional Netlify context. Prefer `netlify login` over storing a token here.
NETLIFY_SITE_ID=

# The package never enables these destructive operations.
KLUB_ALLOW_CMS_RESTORE=false
KLUB_ALLOW_DELETE_EXISTING_BUSINESS_DATA=false
KLUB_ALLOW_PLAN_OR_BILLING_CHANGES=false
