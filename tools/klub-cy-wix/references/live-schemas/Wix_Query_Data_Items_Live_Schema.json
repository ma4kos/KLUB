  "examples": [
    {
      "request": "curl -X POST \\\n'https://www.wixapis.com/wix-data/v2/items/query' \\\n-H 'Content-Type: application/json' \\\n-H 'Authorization: \u003cAUTH\u003e' \\\n-d '{\n    \"dataCollectionId\": \"cities\",\n    \"query\": {\n        \"filter\": {\n            \"state\": \"California\"\n        },\n        \"sort\": [\n            {\n                \"fieldName\": \"population\",\n                \"order\": \"ASC\"\n            }\n        ],\n        \"paging\": {\n            \"limit\": 2\n        },\n        \"fields\": [\"population\"]\n    },\n    \"returnTotalCount\": true\n}'",
      "response": "{\n    \"dataItems\": [\n        {\n            \"id\": \"9b05dd0f-b3b6-481f-a9af-97379f4c81bb\",\n            \"dataCollectionId\": \"cities\",\n            \"data\": {\n                \"population\": 840000.0\n            }\n        },\n        {\n            \"id\": \"5331fc15-9441-4fd4-bc7b-7f6870c69228\",\n            \"dataCollectionId\": \"cities\",\n            \"data\": {\n                \"population\": 3800000.0\n            }\n        }\n    ],\n    \"pagingMetadata\": {\n        \"count\": 2,\n        \"total\": 4,\n        \"tooManyToCount\": false\n    }\n}",
      "title": "Query existing items with filter, sort, paging, projection and total count calculation"
    },
    {
      "request": "curl -X POST \\\n'https://www.wixapis.com/wix-data/v2/items/query' \\\n-H 'Content-Type: application/json' \\\n-H 'Authorization: \u003cAUTH\u003e' \\\n-d '{\n    \"dataCollectionId\": \"cities\",\n    \"query\": {\n        \"filter\": {\n            \"state\": \"California\"\n        },\n        \"paging\": {\n            \"limit\": 2\n        }\n    }\n}'",
      "response": "{\n    \"dataItems\": [\n        {\n            \"id\": \"5331fc15-9441-4fd4-bc7b-7f6870c69228\",\n            \"dataCollectionId\": \"cities\",\n            \"data\": {\n                \"_id\": \"5331fc15-9441-4fd4-bc7b-7f6870c69228\",\n                \"_createdDate\": { \"$date\": \"2023-03-28T12:20:43.745Z\" },\n                \"_updatedDate\": { \"$date\": \"2023-03-28T12:20:43.745Z\" },\n                \"_owner\": \"690264f5-29a0-4aa8-a9b5-0842fc5ab360\",\n                \"state\": \"California\",\n                \"year\": 2022.0,\n                \"city\": \"Los Angeles\",\n                \"population\": 3800000.0\n            }\n        },\n        {\n            \"id\": \"9b05dd0f-b3b6-481f-a9af-97379f4c81bb\",\n            \"dataCollectionId\": \"cities\",\n            \"data\": {\n                \"_id\": \"9b05dd0f-b3b6-481f-a9af-97379f4c81bb\",\n                \"_createdDate\": { \"$date\": \"2023-03-28T12:20:43.745Z\" },\n                \"_updatedDate\": { \"$date\": \"2023-03-28T12:20:43.745Z\" },\n                \"_owner\": \"690264f5-29a0-4aa8-a9b5-0842fc5ab360\",\n                \"state\": \"California\",\n                \"year\": 2022.0,\n                \"city\": \"San Francisco\",\n                \"population\": 840000.0\n            }\n        }\n    ],\n    \"pagingMetadata\": {\n        \"count\": 2,\n        \"tooManyToCount\": false\n    }\n}",
      "title": "Query existing items"
    }
  ],
