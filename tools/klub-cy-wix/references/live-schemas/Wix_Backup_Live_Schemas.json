    "httpMethod": "GET",
    "operationId": "com.wixpress.dstore.api.backup.v2.BackupService.ListBackups",
    "parameters": [
      {
        "description": "Statuses to filter by.\nIf provided, only backups with the specified statuses are listed.\nFor example, to list only completed backups, use `?status=READY`.\nTo list completed and pending backups, use `?status=READY\u0026status=PENDING`.\n\nDefault: No filtering",
        "in": "query",
        "name": "status",
        "required": false,
        "schema": {
          "description": "Statuses to filter by.\nIf provided, only backups with the specified statuses are listed.\nFor example, to list only completed backups, use `?status=READY`.\nTo list completed and pending backups, use `?status=READY\u0026status=PENDING`.\n\nDefault: No filtering",
          "enum": true,
          "items": {
            "enum": [
              {
                "description": "Backup creation is in progress.",
                "value": "PENDING"
              },
              {
                "description": "Backup has been created successfully and can be used for data restoration.",
                "value": "READY"
              },
              {
                "description": "Backup creation has failed.",
                "value": "FAILED"
              },
              {
                "description": "Backup has been deleted.",
                "value": "DELETED"
              },
              {
                "description": "Backup has been canceled.",
                "value": "CANCELED"
              }
            ],
            "title": "Status",
            "type": "string"
          },
          "maxItems": 10,
          "title": "status",
          "type": "array"
        }
      },
      {
        "description": "Type to filter by. If provided, only backups of the specified type are listed.\n\nDefault: No filtering",
        "in": "query",
        "name": "type",
        "required": false,
        "schema": {
          "description": "Type to filter by. If provided, only backups of the specified type are listed.\n\nDefault: No filtering",
          "enum": true,
          "items": {
            "enum": [
              {
                "description": "Backup taken on demand.",
                "value": "ON_DEMAND"
              },
              {
                "description": "Backup taken automatically by the system on a regular schedule.",
                "value": "AUTO"
              }
            ],
            "title": "Type",
            "type": "string"
          },
          "maxItems": 10,
          "title": "type",
          "type": "array"
        }
      },
      {
        "description": "Paging preferences.",
        "in": "query",
        "name": "paging",
        "required": false,
        "schema": {
          "description": "Paging preferences.",
          "properties": {
