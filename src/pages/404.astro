---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page Not Found | KLUB Pilates Limassol"
  description="This page took a rest day. Find KLUB Pilates classes, pricing and timetable from the homepage."
>
  <section class="section center" style="min-height: 55vh; display: flex; align-items: center;">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>This page took a rest day</h1>
      <p class="lede">Even websites need recovery. Let's get you back to moving.</p>
      <div class="btn-row" style="justify-content: center;">
        <a class="btn btn--primary" href="/" data-cta="404-home">Back to Home</a>
        <a class="btn btn--ghost" href="/classes/" data-cta="404-classes">Browse Classes</a>
      </div>
    </div>
  </section>
</Base>
