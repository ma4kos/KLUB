---
import Base from '../layouts/Base.astro';
import { whatsappLink } from '../site';

interface Row { name: string; price: string; per?: string; note: string }
interface Table { title: string; blurb: string; cols: [string, string]; rows: Row[] }

const tables: Table[] = [
  {
    title: 'Getting Started',
    blurb: 'Your first steps on the reformer.',
    cols: ['Per class', 'Best for'],
    rows: [
      { name: 'Drop-In Class', price: '€20', per: '€20', note: 'Try any class, no commitment' },
      { name: 'Intro Pack (2 classes)', price: '€32', per: '€16', note: 'First-timers — your best-value start' },
    ],
  },
  {
    title: 'Monthly Memberships',
    blurb: 'A steady rhythm, month after month.',
    cols: ['Per class', 'Best for'],
    rows: [
      { name: '4 Classes / Month', price: '€120', per: '€30', note: 'A weekly routine' },
      { name: '8 Classes / Month', price: '€200', per: '€25', note: 'Twice-weekly commitment' },
      { name: 'Unlimited', price: '€280', per: '—', note: 'Daily practice' },
    ],
  },
  {
    title: 'Flexi Packs',
    blurb: 'Buy a bundle, book when it suits you.',
    cols: ['Per class', 'Validity'],
    rows: [
      { name: '5-Class Pack', price: '€110', per: '€22', note: 'Valid 2 months' },
      { name: '10-Class Pack', price: '€200', per: '€20', note: 'Valid 3 months' },
    ],
  },
  {
    title: 'Private 1-to-1',
    blurb: 'Fully personalized sessions, by appointment.',
    cols: ['Per session', 'Best for'],
    rows: [
      { name: 'Single Private Session', price: '€80', per: '€80', note: 'One-off focus or assessment' },
      { name: '5-Session Pack', price: '€375', per: '€75', note: 'A short-term goal' },
      { name: '10-Session Pack', price: '€700', per: '€70', note: 'Long-term progress' },
    ],
  },
];

const faqs = [
  {
    q: "What's the difference between a drop-in and the intro pack?",
    a: 'A drop-in is a single class at €20, ideal if you already know reformer Pilates. The intro pack gives new clients their first two classes for €32 — a gentler, better-value way to learn the machine.',
  },
  {
    q: 'Do class packs expire?',
    a: 'Flexi packs are valid for 2 months (5-class) or 3 months (10-class) from purchase. Monthly memberships renew each month.',
  },
  {
    q: 'Can I share a pack with a friend?',
    a: "Packs are personal to you. If you'd like to bring a friend, they can start with a €20 drop-in or the intro pack.",
  },
  {
    q: 'What happens if I need to cancel a booking?',
    a: 'Cancel at least 12 hours before class and your credit is returned automatically. See our policies page for the details.',
  },
];

const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'KLUB Pilates Pricing',
  itemListElement: tables.flatMap((t) =>
    t.rows.map((r) => ({
      '@type': 'Offer',
      name: r.name,
      price: r.price.replace('€', ''),
      priceCurrency: 'EUR',
    }))
  ),
};
---
<Base
  title="Pilates Prices Limassol | Drop-In, Packages & Private | KLUB"
  description="Clear, simple Pilates pricing in Limassol. Drop-in €20. Intro pack €32. Monthly packages from €120. Private 1-to-1 sessions from €70 per session. No hidden fees."
  ogImage="/images/og/pricing.jpg"
  schema={offerSchema}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Pricing</span>
      <h1>Simple, Honest Pricing</h1>
      <p>All prices in euro. What you see is what you pay — no joining fees, no surprises.</p>
    </div>
  </section>

  <section class="section--white tables">
    <div class="container">
      <div class="grid grid--2">
        {tables.map((t) => (
          <div class="card card--pad">
            <h2>{t.title}</h2>
            <p class="blurb">{t.blurb}</p>
            <table class="price-table">
              <thead>
                <tr><th>Package</th><th>Price</th><th>{t.cols[0]}</th><th>{t.cols[1]}</th></tr>
              </thead>
              <tbody>
                {t.rows.map((r) => (
                  <tr>
                    <td>{r.name}</td>
                    <td class="price">{r.price}</td>
                    <td>{r.per}</td>
                    <td>{r.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <a class="btn btn--primary btn--sm" href="/book/">Book Now</a>
          </div>
        ))}
      </div>

      <p class="terms">
        Grip socks are required in all classes (available for purchase at the studio).
        A 12-hour cancellation policy applies — <a href="/policies/">read our full policies</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Pricing questions</h2>
      <div class="accordion">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div class="a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
      <p class="center" style="margin-top: 28px;">
        Anything else? <a href={whatsappLink('Hi KLUB! I have a question about pricing.')} rel="noopener">Message us</a> —
        we usually reply within half an hour.
      </p>
    </div>
  </section>
</Base>

<style>
  .tables { padding: var(--section-y) 0; }
  .tables .card h2 { font-size: 26px; }
  .blurb { color: var(--ink-soft); font-size: 15px; }
  .tables table { margin-bottom: 22px; }
  .terms { margin-top: 32px; color: var(--ink-soft); font-size: 14px; text-align: center; max-width: none; }
</style>
