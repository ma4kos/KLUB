---
import Base from '../layouts/Base.astro';
import page from '../content/pages/policies.json';
import { inline } from '../lib/inline';
---
<Base title={page.seo.title} description={page.seo.description}>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">{page.hero.eyebrow}</span>
      <h1>{page.hero.heading}</h1>
      <p>{page.hero.intro}</p>
    </div>
  </section>

  <section class="section--white" style="padding-block: var(--section-y);">
    <div class="container policies">
      {page.sections.map((s) => (
        <div class="card card--pad">
          <h2>{s.title}</h2>
          <ul>
            {s.items.map((i) => <li set:html={inline(i)} />)}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .policies { display: grid; gap: 24px; max-width: 800px; }
  .policies ul { margin: 0; padding-left: 20px; }
  .policies li { margin-bottom: 10px; color: var(--ink-soft); }
</style>
