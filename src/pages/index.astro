---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import ArchVideo from '../components/ArchVideo.astro';
import Marquee from '../components/Marquee.astro';
import FoundingForm from '../components/FoundingForm.astro';
import { CLASSES } from '../data/classes';
import { SITE, whatsappLink } from '../site';
---
<Base
  title="KLUB | Pilates Reformer Studio in Limassol City Center"
  description="Premium Pilates reformer classes in Limassol city center. Small group sessions & private 1-to-1 training. New to Pilates? Start with our €20 intro offer. Opening September 2026."
  preloadImage="/videos/studio-tour-poster.jpg"
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow rise">Limassol City Center · Opening September 2026</span>
        <h1 class="rise rise-d1">
          Intentional <span class="ital">movement.</span><br />
          Mindful <span class="ital">strength.</span>
        </h1>
        <p class="lede rise rise-d2">
          Premium reformer Pilates in the heart of Limassol — small groups of six, private
          1-to-1 sessions, and a space that feels like an exhale.
        </p>
        <div class="btn-row rise rise-d3">
          <a class="btn btn--primary" href="/book/">Book Your First Class — €20</a>
          <a class="btn btn--ghost" href="/timetable/">View Timetable</a>
        </div>
      </div>
      <div class="hero-media rise rise-d2">
        <ArchVideo src="/videos/studio-tour.mp4" poster="/videos/studio-tour-poster.jpg" class="hero-film" />
        <div class="hero-mini arch">
          <Pic
            src="/images/arch-entrance.jpg"
            alt="Arched entrance of KLUB Pilates studio in Limassol with a glowing circular KLUB logo and olive tree"
            width={322} height={431} loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <Marquee items={[
    'Reformer Pilates',
    '<em>Limassol City Center</em>',
    'Small groups of six',
    'Classes in <em>English</em>',
    'Private 1-to-1',
    'Pre &amp; post-natal certified',
    'Opening <em>September 2026</em>',
  ]} />

  <!-- World to island story -->
  <section class="section section--white">
    <div class="container">
      <div class="story-head reveal">
        <span class="eyebrow">The KLUB Standard</span>
        <h2>The world's best Pilates,<br /><span class="ital">brought home to Cyprus</span></h2>
        <p class="lede">
          Our founder trained and taught in the studios of London and Dubai — and built her
          online studio from the island. KLUB brings all of it home to Limassol.
        </p>
      </div>
      <div class="triptych">
        <div class="reveal"><ArchVideo src="/videos/dubai-studio.mp4" poster="/videos/dubai-studio-poster.jpg" label="Refined abroad" sublabel="Teaching in Dubai's studios" /></div>
        <div class="reveal reveal-d1"><ArchVideo src="/videos/cyprus-pool.mp4" poster="/videos/cyprus-pool-poster.jpg" label="Rooted in Cyprus" sublabel="Movement under the Limassol sun" /></div>
        <div class="reveal reveal-d2"><ArchVideo src="/videos/studio-lounge.mp4" poster="/videos/studio-lounge-poster.jpg" label="Home in Limassol" sublabel="The KLUB studio, ready for you" /></div>
      </div>
      <div class="stat-row story-stats reveal">
        <div class="stat"><b>6</b><span>people max per class — you're seen, every rep</span></div>
        <div class="stat"><b>50<small>′</small></b><span>minutes of focused, full-body work</span></div>
        <div class="stat"><b>3</b><span>cities of training behind every class — London, Dubai, Cyprus</span></div>
        <div class="stat"><b>€20</b><span>your first class. No commitment, all welcome</span></div>
      </div>
    </div>
  </section>

  <!-- About preview -->
  <section class="section">
    <div class="container split">
      <div class="arch reveal">
        <Pic
          src="/images/reception.jpg"
          alt="Warm minimalist reception area at KLUB Pilates Limassol with stone desk, soft seating and natural textures"
          width={467} height={431}
        />
      </div>
      <div class="reveal reveal-d1">
        <span class="eyebrow">About KLUB</span>
        <h2>A space built <span class="ital">for balance</span></h2>
        <p>
          KLUB stands for <em>Keep Living Under Balance</em>. Warm plaster walls, arched
          doorways, soft light and calm proportions — a studio designed to slow you down the
          moment you walk in.
        </p>
        <p>
          On the floor it's serious equipment and small groups: reformer classes capped at six,
          so your instructor sees every rep — your alignment, your pace, your progress.
        </p>
        <p class="pull-quote">Chill vibes are found here.</p>
        <a class="btn btn--ghost" href="/about/">Step Inside</a>
      </div>
    </div>
  </section>

  <!-- Classes preview -->
  <section class="section section--white">
    <div class="container">
      <div class="center reveal">
        <span class="eyebrow">Classes</span>
        <h2>Find <span class="ital">your</span> class</h2>
        <p class="lede">Four ways to move, from your first step to your strongest self.</p>
      </div>
      <div class="grid grid--4 class-grid">
        {CLASSES.map((c, i) => (
          <a class:list={['card class-card reveal', `reveal-d${i % 4 === 0 ? 0 : i % 4}`]} href={`/classes/${c.slug}/`}>
            <div class="class-img">
              <Pic src={c.image} alt={c.imageAlt} width={360} height={300} />
            </div>
            <div class="class-body">
              <h3>{c.name}</h3>
              <p>{c.short}</p>
              <span class="more">Learn more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Meet Izzy teaser -->
  <section class="section section--sand">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow">Your Instructor</span>
        <h2>Meet <span class="ital">Izzy</span></h2>
        <p class="lede">
          Royal Academy of Dance graduate. Certified reformer and mat Pilates instructor.
          Pre/post-natal qualified. From London stages to Dubai studios — now bringing it all
          home to Limassol.
        </p>
        <a class="btn btn--primary" href="/instructors/">Her Story</a>
      </div>
      <div class="arch izzy-teaser reveal reveal-d1">
        <Pic
          src="/images/izzy-dubai-teaching.jpg"
          alt="Izzy Nicolaou guiding a reformer Pilates class in an arched, softly lit Dubai studio"
          width={480} height={620}
        />
      </div>
    </div>
  </section>

  <!-- Pricing teaser -->
  <section class="section section--white">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow">Pricing</span>
        <h2>Transparent <span class="ital">pricing</span></h2>
        <p>No hidden fees. No complicated tiers. Just clear options that fit how you want to move.</p>
        <a class="btn btn--primary" href="/pricing/">View Full Price List</a>
      </div>
      <div class="grid price-teaser reveal reveal-d1">
        <div class="card card--pad center">
          <span class="eyebrow">Drop-In</span>
          <p class="big-price">€20</p>
          <p>Try any group class</p>
        </div>
        <div class="card card--pad center">
          <span class="eyebrow">Intro Pack</span>
          <p class="big-price">€32</p>
          <p>Your first two reformer classes</p>
        </div>
        <div class="card card--pad center">
          <span class="eyebrow">Private Session</span>
          <p class="big-price">€80</p>
          <p>1-to-1 personal training</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Location -->
  <section class="section">
    <div class="container split">
      <div class="arch reveal">
        <Pic
          src="/images/street-sign.jpg"
          alt="Illuminated KLUB sign mounted on a stone building facade in Limassol city center"
          width={358} height={294}
        />
      </div>
      <div class="reveal reveal-d1">
        <span class="eyebrow">Find Us</span>
        <h2>In the heart <span class="ital">of Limassol</span></h2>
        <p>
          {SITE.addressLocality}, {SITE.addressCountry}.<br />
          <em>{SITE.addressNote}</em>
        </p>
        <div class="btn-row">
          <a class="btn btn--ghost" href="/location/">Location &amp; Directions</a>
          <a class="btn btn--accent" href={whatsappLink('Hi KLUB! Where exactly are you located?')} rel="noopener">Message Us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Founding member -->
  <section class="section section--dark">
    <div class="container split">
      <div class="reveal">
        <h2>Be part of the <span class="ital">founding circle</span></h2>
        <p>
          Join before we open for exclusive founding member rates and first access to bookings.
          Early members choose their class times before anyone else.
        </p>
      </div>
      <div class="reveal reveal-d1">
        <FoundingForm compact />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(48px, 7vw, 96px) 0 clamp(48px, 7vw, 88px); overflow: hidden; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .hero-copy .lede { max-width: 46ch; }
  .hero-media { position: relative; max-width: 400px; justify-self: center; width: 100%; }
  .hero-media :global(.hero-film) { width: 82%; margin-left: auto; }
  .hero-mini {
    position: absolute;
    left: -6%;
    bottom: -8%;
    width: 44%;
    box-shadow: 0 24px 48px -24px rgba(26, 23, 20, 0.35);
    background: var(--sand);
  }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-media { max-width: 320px; margin-top: 12px; }
  }

  .story-head { max-width: 720px; margin-bottom: 48px; }
  .triptych {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3.5vw, 44px);
    align-items: end;
  }
  .triptych > div:nth-child(2) { transform: translateY(-24px); }
  @media (max-width: 780px) {
    .triptych { grid-template-columns: 1fr; max-width: 340px; margin: 0 auto; }
    .triptych > div:nth-child(2) { transform: none; }
  }
  .story-stats { margin-top: clamp(48px, 6vw, 72px); border-top: 1px solid var(--line); padding-top: 40px; }

  .class-grid { margin-top: 48px; }
  .class-card { text-decoration: none; color: var(--ink); overflow: hidden; display: flex; flex-direction: column; }
  .class-img { aspect-ratio: 6/5; overflow: hidden; }
  .class-img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
  .class-card:hover .class-img :global(img) { transform: scale(1.05); }
  .class-body { padding: 20px 22px 24px; }
  .class-body h3 { font-size: 21px; }
  .class-body p { font-size: 14px; color: var(--ink-soft); }
  .more { font: 500 13px/1.4 var(--sans); letter-spacing: 0.04em; text-transform: uppercase; color: var(--umber); }

  .izzy-teaser { max-width: 420px; justify-self: center; }

  .price-teaser { grid-template-columns: 1fr; gap: 16px; }
  .big-price { font-family: var(--serif); font-size: 44px; margin: 0; }
  .price-teaser p:last-child { color: var(--ink-soft); font-size: 14px; margin: 0; }

  .stat b small { font-size: 0.55em; }
</style>
