---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import FoundingForm from '../components/FoundingForm.astro';
import { CLASSES } from '../data/classes';
import { SITE, whatsappLink, bookLink, primaryCta } from '../site';
import home from '../content/home.json';
import { inline } from '../lib/inline';
---
<Base
  title={home.seo.title}
  description={home.seo.description}
  preloadImage={home.heroImage}
>
  <!-- Hero — tracked-out caps beside the studio photo, per Alex's Option 1 -->
  <section class="hero" data-section="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="hero-caps" set:html={inline(home.heroHeading)} />
        <p class="lede rise rise-d2">{home.heroLede}</p>
        <div class="btn-row rise rise-d3">
          <a class="btn btn--primary" href={bookLink()} data-cta="hero-book">{primaryCta()}</a>
          <a class="btn btn--ghost" href="/about/" data-cta="hero-philosophy">{home.heroSecondaryLabel} →</a>
        </div>
      </div>
      <div class="hero-media rise rise-d1">
        <Pic src={home.heroImage} alt={home.heroAlt} width={1168} height={1347} loading="eager" />
      </div>
    </div>
  </section>

  <!-- 01 · The Klub -->
  <section class="section section--white" data-section="the-klub">
    <div class="container split">
      <div class="reveal">
        <div class="chapter">
          <span class="chapter-no" aria-hidden="true">01</span>
          <div>
            <h2 set:html={inline(home.about.heading)} />
          </div>
        </div>
        <p class="chapter-text">{home.about.text}</p>
        <a class="link-arrow" href="/about/" data-cta="about-more">{home.about.buttonLabel} →</a>
      </div>
      <div class="wide-frame about-media reveal reveal-d1">
        <Pic src={home.about.image} alt={home.about.alt} width={1649} height={954} />
      </div>
    </div>
  </section>

  <!-- 02 · Find your balance (the four classes as cards) -->
  <section class="section" data-section="classes">
    <div class="container split split--heads">
      <div class="reveal">
        <div class="chapter">
          <span class="chapter-no" aria-hidden="true">02</span>
          <div>
            <h2 set:html={inline(home.classesHead.heading)} />
          </div>
        </div>
        <p class="chapter-text">{home.classesHead.lede}</p>
        <a class="link-arrow" href="/classes/" data-cta="classes-all">{home.classesHead.buttonLabel} →</a>
      </div>
      <div class="class-cards">
        {CLASSES.map((c, i) => (
          <a class:list={['class-card reveal', i ? `reveal-d${i}` : '']} href={`/classes/${c.slug}/`} data-cta={`class-${c.slug}`}>
            <div class="card-thumb">
              <Pic src={c.image} alt="" width={520} height={390} />
            </div>
            <h3>{c.name}</h3>
            <p>{c.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 · Start here (intro offer) -->
  <section class="section section--white" data-section="start-here">
    <div class="container split">
      <div class="reveal">
        <div class="chapter">
          <span class="chapter-no" aria-hidden="true">03</span>
          <div>
            <h2 set:html={inline(home.intro.heading)} />
          </div>
        </div>
        <p class="offer-line">{home.intro.offer}</p>
        <ul class="includes">
          {home.intro.includes.map((it) => <li>{it}</li>)}
        </ul>
        <a class="btn btn--primary" href={bookLink()} data-cta="intro-claim">{home.intro.buttonLabel}</a>
      </div>
      <div class="wide-frame offer-media reveal reveal-d1">
        <Pic src={home.intro.image} alt={home.intro.alt} width={1708} height={920} />
      </div>
    </div>
  </section>

  <!-- 04 · The KLUB experience (two framed studio shots) -->
  <section class="section" data-section="experience">
    <div class="container split split--heads">
      <div class="reveal">
        <div class="chapter">
          <span class="chapter-no" aria-hidden="true">04</span>
          <div>
            <h2 set:html={inline(home.experience.heading)} />
          </div>
        </div>
        <p class="chapter-text">{home.experience.text}</p>
        <a class="link-arrow" href="/about/" data-cta="experience-look">{home.experience.buttonLabel} →</a>
      </div>
      <div class="exp-gallery">
        {home.experience.gallery.map((g, i) => (
          <div class:list={['exp-shot reveal', i ? `reveal-d${i}` : '']}>
            <Pic src={g.image} alt={g.alt} width={640} height={520} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 · Move with us (community / team) -->
  <section class="section section--sand" data-section="instructors">
    <div class="container">
      <div class="chapter reveal">
        <span class="chapter-no" aria-hidden="true">05</span>
        <div>
          <h2 set:html={inline(home.community.heading)} />
          <p class="chapter-text">
            {home.community.lede}<br />
            <a class="quiet-link" href="/location/">{home.community.locationLine} →</a>
          </p>
          <a class="link-arrow" href="/instructors/" data-cta="instructors-meet">{home.community.buttonLabel} →</a>
        </div>
      </div>
      <div class="wide-frame community-photo reveal reveal-d1">
        <Pic src={home.community.image} alt={home.community.alt} width={2038} height={771} />
      </div>
    </div>
  </section>

  <!-- 06 · Find us (location) -->
  <section class="section" data-section="location">
    <div class="container split">
      <div class="reveal">
        <div class="chapter">
          <span class="chapter-no" aria-hidden="true">06</span>
          <div>
            <h2 set:html={inline(home.location.heading)} />
          </div>
        </div>
        <p class="chapter-text">
          {SITE.streetAddress ? <>{SITE.streetAddress},<br /></> : null}
          {SITE.addressLocality}, {SITE.addressCountry}.
          {!SITE.streetAddress && <><br /><span class="note">{SITE.addressNote}</span></>}
        </p>
        <div class="parking-row">
          {home.location.parking.map((p) => (
            <div class="parking-item">
              <span class="parking-p" aria-hidden="true">P</span>
              <span><b>{p.label}</b><br />{p.note}</span>
            </div>
          ))}
        </div>
        <div class="btn-row">
          <a class="btn btn--ghost" href="/location/" data-cta="location-directions">{home.location.directionsLabel}</a>
          <a class="btn btn--accent" href={whatsappLink('Hi KLUB! Where exactly are you located?')} rel="noopener" data-cta="location-message">{home.location.messageLabel}</a>
        </div>
      </div>
      <div class="arch location-media reveal reveal-d1">
        <Pic src={home.location.image} alt={home.location.alt} width={716} height={588} />
      </div>
    </div>
  </section>

  <!-- 07 · Keep living under balance (closing CTA + founding capture) -->
  <section class="section section--dark" data-section="founding">
    <div class="container split">
      <div class="reveal">
        <div class="chapter chapter--dark">
          <span class="chapter-no" aria-hidden="true">07</span>
          <div>
            <h2 class="closing-caps" set:html={inline(home.closing.heading)} />
          </div>
        </div>
        <p class="chapter-text">{home.closing.text}</p>
        <a class="btn btn--light" href={bookLink()} data-cta="closing-book">{home.closing.buttonLabel} →</a>
      </div>
      <div class="wide-frame closing-media reveal reveal-d1">
        <Pic src={home.closing.image} alt={home.closing.alt} width={1572} height={1001} />
      </div>
    </div>
    <div class="container closing-signup reveal">
      <FoundingForm compact source="home" />
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(48px, 7vw, 96px) 0 clamp(48px, 7vw, 88px); overflow: hidden; }
  .hero-grid {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  /* Tracked-out caps hero — the editorial treatment from Alex's Option 1.
     Uppercase + letter-spacing via CSS so screen readers still hear words.
     Line breaks come from the CMS heading; no width cap fights them. */
  .hero-caps {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-right: -0.14em;
    font-size: clamp(38px, 5.2vw, 64px);
    line-height: 1.12;
  }
  .hero-copy .lede { max-width: 34ch; }
  .hero-media { justify-self: stretch; width: 100%; }
  .hero-media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1168 / 1347;
    object-fit: cover;
    border-radius: var(--radius-card);
    border: 1px solid var(--line);
    background: var(--sand);
    box-shadow: 0 24px 48px -24px rgba(26, 23, 20, 0.28);
  }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-media { margin-top: 12px; }
  }

  /* Numbered chapter headers — the scroll's narrative spine.
     Tabular numerals + a fixed ch gutter keep all seven numbers on one axis. */
  .chapter { display: flex; gap: clamp(16px, 2.5vw, 28px); align-items: flex-start; margin-bottom: 20px; }
  .chapter-no {
    font: 400 clamp(38px, 4.5vw, 58px)/1 var(--serif);
    font-variant-numeric: tabular-nums;
    color: var(--umber);
    opacity: 0.35;
    padding-top: 6px;
    min-width: 2.2ch;
  }
  .chapter--dark .chapter-no { color: var(--sand); opacity: 0.5; }
  .section--sand .chapter-no { opacity: 0.45; }
  .chapter h2 { margin-bottom: 0.35em; }
  .chapter-text { margin: 0 0 18px; max-width: 38ch; color: var(--ink-soft); }

  /* Understated arrow links (READ MORE →, EXPLORE CLASSES →) per the mock */
  .link-arrow {
    display: inline-block;
    font: 500 13px/1.4 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 3px;
  }
  .link-arrow:hover { color: var(--umber); border-color: var(--umber); }
  .quiet-link { color: var(--ink-soft); text-decoration: none; }
  .quiet-link:hover { color: var(--umber); }

  /* The four classes as photo cards (photo · caps name · descriptor) */
  .split--heads { align-items: start; }
  .class-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(14px, 2vw, 22px);
  }
  .class-card { text-decoration: none; color: var(--ink); display: block; }
  .card-thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    margin-bottom: 12px;
    transform: translateZ(0);
  }
  .card-thumb :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
  .class-card:hover .card-thumb :global(img),
  .class-card:focus-visible .card-thumb :global(img) { transform: scale(1.05); }
  .class-card h3 {
    font: 500 14px/1.4 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 4px;
  }
  .class-card p { margin: 0; font-size: 14px; color: var(--ink-soft); }
  .class-card:focus-visible { outline: 2px solid var(--umber); outline-offset: 4px; border-radius: var(--radius-sm); }
  @media (max-width: 600px) {
    .class-cards { grid-template-columns: 1fr 1fr; gap: 12px; }
  }

  /* Intro offer — big line + checklist + one button, photo alongside */
  .offer-line {
    font: 500 15px/1.4 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }
  .includes { list-style: none; padding: 0; margin: 0 0 24px; max-width: 340px; }
  .includes li {
    padding: 8px 0 8px 26px;
    border-bottom: 1px solid var(--line);
    position: relative;
    font-size: 15px;
    color: var(--ink-soft);
  }
  .includes li::before { content: "✓"; position: absolute; left: 2px; color: var(--umber); }
  .includes li:last-child { border-bottom: none; }
  .about-media { aspect-ratio: 1649 / 954; align-self: center; }
  .offer-media { aspect-ratio: 1708 / 920; align-self: center; }

  /* Two framed studio shots, per the mock's 04 */
  .exp-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(14px, 2vw, 22px);
  }
  .exp-shot {
    overflow: hidden;
    border-radius: var(--radius-card);
    border: 1px solid var(--line);
    aspect-ratio: 4 / 3;
  }
  .exp-shot :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 720px) {
    .exp-gallery { grid-template-columns: 1fr; }
    .exp-shot { aspect-ratio: 3 / 2; }
  }

  /* Wide rounded photo frame (per the Option 1 concept's rectangular imagery) */
  .wide-frame {
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--line);
    aspect-ratio: 8 / 5;
  }
  .wide-frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  /* Match the panorama source's own ratio so no one is cropped out */
  .community-photo { aspect-ratio: 2038 / 771; margin-top: 8px; }

  /* Parking badges, per the mock's 06 */
  .parking-row { display: flex; gap: 28px; margin: 0 0 22px; }
  .parking-item { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: var(--ink-soft); }
  .parking-item b { color: var(--ink); font-weight: 600; }
  .parking-p {
    font: 400 30px/1 var(--serif);
    color: var(--umber);
    border: 1px solid var(--umber);
    border-radius: 6px;
    padding: 4px 9px 6px;
  }

  .location-media { aspect-ratio: 358 / 294; }
  .location-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .note { font-style: normal; color: var(--ink-soft); }

  /* 07 closing — the caps headline again, small and dark, per the mock */
  .closing-media { aspect-ratio: 1572 / 1001; align-self: center; }
  .closing-signup { max-width: 640px; margin-top: clamp(32px, 5vw, 48px); }
  .closing-caps {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-right: -0.14em;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.18;
  }
  .section--dark .chapter-text { color: var(--sand); opacity: 0.85; }
</style>
