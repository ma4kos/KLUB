---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { whatsappLink } from '../site';

const izzySchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Elizabeth "Izzy" Nicolaou',
  jobTitle: 'Founder & Lead Pilates Instructor',
  worksFor: { '@type': 'Organization', name: 'KLUB Pilates Studio' },
  alumniOf: 'Royal Academy of Dance',
  knowsLanguage: ['English', 'Greek'],
  sameAs: ['https://www.instagram.com/pilateswithizzy', 'https://www.instagram.com/pilatizstudio'],
};
---
<Base
  title="Meet Our Pilates Instructors | KLUB Limassol"
  description="Meet Izzy Nicolaou, founder of KLUB Limassol — Royal Academy of Dance graduate, certified reformer Pilates instructor and pre/post-natal specialist. Classes in English."
  ogImage="/images/izzy-pilates.jpg"
  schema={izzySchema}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Instructors</span>
      <h1>The People Behind the Practice</h1>
      <p>Internationally trained, fully certified — and genuinely glad you came.</p>
    </div>
  </section>

  <section class="section--white bios">
    <div class="container">
      <article class="card bio">
        <div class="portrait">
          <Pic
            src="/images/izzy-pilates.jpg"
            alt="Izzy Nicolaou practicing a side-lying Pilates leg lift on a mat in front of sheer curtains"
            width={420} height={525} loading="eager"
          />
        </div>
        <div class="body">
          <h2>Elizabeth "Izzy" Nicolaou</h2>
          <p class="creds">
            Founder &amp; Lead Instructor · BA (Hons) Ballet Education, Royal Academy of Dance ·
            Certified Reformer &amp; Mat Pilates Instructor · Pre/Post-Natal Qualified
          </p>
          <p>
            Izzy is a classically trained ballet teacher turned Pilates instructor, with a
            Bachelor of Arts with Honours in Ballet Education from the Royal Academy of Dance.
            Her teaching career has taken her from London to Dubai and home to Cyprus — and that
            journey shapes every class she leads: precise like ballet, welcoming like a friend's
            living room.
          </p>
          <p>
            She came to the reformer through dance, using it to build the core strength, posture
            and control that dancers depend on — and quickly discovered it does the same for
            every body, whether you sit at a desk all day or train for sport. She is fully
            qualified in pre- and post-natal movement, so mothers and mothers-to-be train with
            complete confidence.
          </p>
          <p>
            Between studio sessions, Izzy runs <a href="https://www.instagram.com/pilatizstudio" rel="noopener">PILATIZ</a>,
            her online studio — on-demand workouts, live classes and monthly challenges you can
            do from anywhere. If you want to start moving before KLUB opens its doors, that is
            the place.
          </p>
          <p class="creds">Languages: English, Greek</p>
          <div class="btn-row">
            <a class="btn btn--primary btn--sm" href="/book/">Book a class with Izzy</a>
            <a class="btn btn--ghost btn--sm" href="https://www.instagram.com/pilateswithizzy" rel="noopener">Follow @pilateswithizzy</a>
          </div>
        </div>
      </article>

      <div class="card card--pad online">
        <h3>Can't wait for opening day?</h3>
        <p>
          Train with Izzy online now through PILATIZ — workouts from 10 to 40 minutes, beginner
          to advanced, new sessions every month.
        </p>
        <a class="btn btn--accent btn--sm" href="https://www.instagram.com/pilatizstudio" rel="noopener">Visit PILATIZ Online Studio</a>
      </div>

      <p class="center closing">
        All our instructors are fully certified and insured. Questions about qualifications?
        <a href={whatsappLink('Hi KLUB! I have a question about your instructors.')} rel="noopener">Ask us anytime</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .bios { padding: var(--section-y) 0; }
  .bio { display: grid; grid-template-columns: 1fr 1.6fr; overflow: hidden; margin-bottom: 28px; }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .body { padding: clamp(24px, 4vw, 44px); }
  .creds { font-size: 14px; color: var(--umber); font-weight: 500; }
  @media (max-width: 780px) {
    .bio { grid-template-columns: 1fr; }
    .portrait :global(img) { max-height: 420px; }
  }
  .online { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; background: var(--sand); border-color: var(--sand); }
  .online h3 { margin-bottom: 2px; }
  .closing { margin-top: 32px; }
</style>
