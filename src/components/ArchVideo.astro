---
// Muted looping film inside an arch frame — the KLUB signature.
// Below-the-fold films are lazy-loaded (only fetched when scrolled near the
// viewport); pass `eager` for the above-the-fold hero film so it loads at once.
interface Props {
  src: string;
  poster: string;
  label?: string;
  sublabel?: string;
  eager?: boolean;
  class?: string;
}
const { src, poster, label, sublabel, eager = false, class: cls } = Astro.props;
---
<figure class:list={['arch-film', cls]}>
  <div class="arch-video">
    {/* The film is decorative — the figcaption carries the meaning — so it is
        hidden from assistive tech. The injected pause button stays exposed. */}
    {eager ? (
      <video autoplay muted loop playsinline preload="metadata" poster={poster} aria-hidden="true">
        <source src={src} type="video/mp4" />
      </video>
    ) : (
      <video muted loop playsinline preload="none" poster={poster} data-src={src} aria-hidden="true"></video>
    )}
  </div>
  {label && (
    <figcaption>
      <span class="l">{label}</span>
      {sublabel && <span class="s">{sublabel}</span>}
    </figcaption>
  )}
</figure>

<style>
  .arch-film { margin: 0; }
  figcaption { text-align: center; margin-top: 14px; }
  .l {
    display: block;
    font-family: var(--serif);
    font-size: 22px;
  }
  .s {
    display: block;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: 2px;
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Respect reduced motion: pause the eager (autoplaying) hero film.
  if (reduce) {
    document.querySelectorAll('.arch-video video[autoplay]').forEach((v) => {
      const vid = v as HTMLVideoElement;
      vid.removeAttribute('autoplay');
      vid.pause();
    });
  }

  // Lazy films: only fetch + play once scrolled near the viewport.
  const lazy = Array.from(
    document.querySelectorAll('.arch-video video[data-src]')
  ) as HTMLVideoElement[];

  // WCAG 2.2.2: anything that moves for more than five seconds needs a control.
  // Mirrors the hero film's toggle on the homepage; shares its .video-toggle CSS
  // from src/styles/global.css.
  const addToggle = (v: HTMLVideoElement) => {
    const frame = v.parentElement;
    if (!frame || frame.querySelector('.video-toggle')) return;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'video-toggle';
    const sync = () => {
      const playing = !v.paused;
      btn.setAttribute('aria-label', playing ? 'Pause film' : 'Play film');
      btn.textContent = playing ? '❚❚' : '▶';
    };
    btn.addEventListener('click', () => {
      if (v.paused) {
        const p = v.play();
        if (p && typeof p.catch === 'function') p.catch(() => {});
      } else {
        v.pause();
      }
      sync();
    });
    v.addEventListener('play', sync);
    v.addEventListener('pause', sync);
    frame.appendChild(btn);
    sync();
  };

  // Eager (autoplaying) films need the same control the moment the page loads.
  if (!reduce) {
    document
      .querySelectorAll('.arch-video video[autoplay]')
      .forEach((v) => addToggle(v as HTMLVideoElement));
  }

  const activate = (v: HTMLVideoElement) => {
    if (v.dataset.loaded) return;
    v.dataset.loaded = '1';
    if (v.dataset.src) v.src = v.dataset.src;
    v.load();
    if (!reduce) {
      const p = v.play();
      if (p && typeof p.catch === 'function') p.catch(() => {});
      addToggle(v);
    }
  };

  if (lazy.length) {
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              activate(e.target as HTMLVideoElement);
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '200px 0px' }
      );
      lazy.forEach((v) => io.observe(v));
    } else {
      lazy.forEach(activate);
    }
  }
</script>
