---
// Measurement layer. Two halves:
//
// 1. Vendor loaders — GA4 (gtag.js) and Microsoft Clarity load ONLY when their
//    IDs are set in the CMS (Studio Settings → Analytics). With the IDs empty
//    the site ships zero third-party scripts and sets zero cookies.
//
// 2. Event instrumentation — always on, vendor-agnostic. Pushes into
//    window.dataLayer, which GA4 picks up when active and which any tag
//    manager can consume later. Instruments:
//      cta_click     every element carrying data-cta (the id names the button)
//      book_click    any click toward the booking flow (/book/ or bookingUrl)
//      section_view  first time a [data-section] block enters the viewport
//      scroll_depth  25 / 50 / 75 / 90% of the page, once each
//
// GDPR note (Cyprus = EU): before setting ga4Id/clarityId in production, add a
// consent notice — see docs/handover-for-alex.md.
import { SITE, bookLink } from '../site';

const ga4 = SITE.ga4Id || '';
const clarity = SITE.clarityId || '';
const bookHref = bookLink();
---
{ga4 && <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>}
{ga4 && (
  <script is:inline define:vars={{ ga4 }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', ga4, { anonymize_ip: true });
  </script>
)}
{clarity && (
  <script is:inline define:vars={{ clarity }}>
    (function (c, l, a, r, i, t, y) {
      c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
      t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
      y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
    })(window, document, 'clarity', 'script', clarity);
  </script>
)}

<script is:inline define:vars={{ bookHref }}>
  (function () {
    var w = window;
    w.dataLayer = w.dataLayer || [];
    // Small helper other scripts can reuse: klubTrack('event_name', {...})
    w.klubTrack = function (name, params) {
      try {
        if (typeof w.gtag === 'function') { w.gtag('event', name, params || {}); }
        else { w.dataLayer.push({ event: name, ...(params || {}) }); }
      } catch (e) { /* analytics must never break the page */ }
    };

    // CTA + booking clicks
    document.addEventListener('click', function (e) {
      var el = e.target instanceof Element ? e.target.closest('a, button') : null;
      if (!el) return;
      var cta = el.getAttribute('data-cta');
      var href = el.getAttribute('href') || '';
      if (cta) {
        w.klubTrack('cta_click', {
          cta_id: cta,
          cta_label: (el.textContent || '').trim().slice(0, 80),
          page_path: location.pathname,
        });
      }
      if (href && (href === bookHref || href.indexOf('/book/') === 0)) {
        w.klubTrack('book_click', {
          cta_id: cta || 'unlabelled',
          link_url: href,
          page_path: location.pathname,
        });
      }
    });

    // Section views — which chapters of the page people actually reach
    var sections = document.querySelectorAll('[data-section]');
    if ('IntersectionObserver' in w && sections.length) {
      var seen = {};
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting) return;
          var id = en.target.getAttribute('data-section');
          if (id && !seen[id]) {
            seen[id] = true;
            w.klubTrack('section_view', { section: id, page_path: location.pathname });
            io.unobserve(en.target);
          }
        });
      }, { threshold: 0.15 });
      sections.forEach(function (el) { io.observe(el); });
    }

    // Scroll depth
    var marks = [25, 50, 75, 90];
    var fired = {};
    function onScroll() {
      var max = document.documentElement.scrollHeight - w.innerHeight;
      if (max <= 0) return;
      var pct = Math.round((w.scrollY / max) * 100);
      for (var i = 0; i < marks.length; i++) {
        var m = marks[i];
        if (pct >= m && !fired[m]) {
          fired[m] = true;
          w.klubTrack('scroll_depth', { percent: m, page_path: location.pathname });
        }
      }
      if (fired[90]) w.removeEventListener('scroll', onScroll);
    }
    w.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
