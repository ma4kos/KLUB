---
import { BANNER } from '../site';

// The dismissal key is derived from the banner's own content, so when the studio
// edits the announcement in the CMS it becomes a new banner that everyone sees
// again — a single fixed key would have made this a once-per-visitor-forever
// feature, which is the opposite of a reusable announcement bar.
const key =
  'klub-banner-' +
  [...((BANNER.text || '') + (BANNER.linkUrl || ''))]
    .reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7)
    .toString(36);
---
{BANNER.enabled && (
<div class="banner" id="klub-banner" data-key={key}>
  <p>
    {BANNER.text}
    {BANNER.linkUrl && BANNER.linkText && <a href={BANNER.linkUrl}>{BANNER.linkText}</a>}
  </p>
  <button type="button" aria-label="Dismiss announcement" id="klub-banner-close">&times;</button>
</div>
)}
<script is:inline>
  // Runs before first paint: hide the banner synchronously if this exact
  // announcement was previously dismissed, so returning visitors get no layout
  // shift. Storage can throw in strict privacy modes — in that case the banner
  // just stays visible.
  try {
    var klubBanner = document.getElementById('klub-banner');
    var klubBannerKey = klubBanner && klubBanner.dataset.key;
    if (klubBannerKey && localStorage.getItem(klubBannerKey) === '1') {
      klubBanner.setAttribute('hidden', '');
    }
  } catch {}
</script>

<style>
  .banner[hidden] { display: none; }
  .banner {
    background: var(--umber);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 10px 48px 10px 20px;
    position: relative;
    font-size: 14px;
    text-align: center;
  }
  .banner p { margin: 0; max-width: none; }
  .banner a { color: #fff; font-weight: 600; }
  .banner button {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    background: none; border: 0; color: #fff; font-size: 22px; line-height: 1;
    cursor: pointer; padding: 4px 8px;
  }
</style>

<script>
  document.getElementById('klub-banner-close')?.addEventListener('click', () => {
    const banner = document.getElementById('klub-banner');
    banner?.setAttribute('hidden', '');
    const key = banner?.dataset.key;
    if (!key) return;
    try {
      localStorage.setItem(key, '1');
      // Sweep dismissals of older announcements so storage does not grow with
      // every banner the studio publishes.
      Object.keys(localStorage)
        .filter((k) => k.startsWith('klub-banner-') && k !== key)
        .forEach((k) => localStorage.removeItem(k));
    } catch {}
  });
</script>
