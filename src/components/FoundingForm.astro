---
// Netlify Forms-compatible signup form (works automatically when hosted on Netlify).
// On other hosts, point the action at a Formspree endpoint instead.
// `source` is captured as a hidden field so each signup shows which page it came
// from (home, book, timetable, founding-page) in the Netlify dashboard.
interface Props { compact?: boolean; source?: string }
const { compact = false, source = 'founding-page' } = Astro.props;
---
<form
  class="founding-form"
  name="founding-member"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  action="/founding-member/?success=true"
>
  <input type="hidden" name="form-name" value="founding-member" />
  <input type="hidden" name="source" value={source} />
  <p hidden><label>Don't fill this in: <input name="bot-field" /></label></p>

  {!compact && (
    <div class="field">
      <label for="ff-name">Name</label>
      <input id="ff-name" type="text" name="name" autocomplete="name" required />
    </div>
  )}
  <div class="field">
    <label for="ff-email">Email</label>
    <input id="ff-email" type="email" name="email" autocomplete="email" required placeholder="you@example.com" />
  </div>
  {!compact && (
    <>
      <div class="field">
        <label for="ff-phone">Phone / WhatsApp (optional)</label>
        <input id="ff-phone" type="tel" name="phone" autocomplete="tel" />
      </div>
      <div class="field">
        <label for="ff-interest">What interests you most?</label>
        <select id="ff-interest" name="interest">
          <option>Small-group reformer classes</option>
          <option>Private 1-to-1 sessions</option>
          <option>Pre/post-natal Pilates</option>
          <option>I'm new to Pilates</option>
          <option>Just curious</option>
        </select>
      </div>
    </>
  )}
  <div class="consent">
    <input type="checkbox" id="ff-consent" name="consent" value="yes" required aria-describedby="ff-consent-note" />
    <label for="ff-consent">Keep me posted about KLUB's opening and founding-member offers, and I accept the privacy policy.</label>
  </div>
  <p id="ff-consent-note" class="consent-note"><a href="/policies/">Read the privacy policy</a></p>
  <button class="btn btn--accent" type="submit" data-cta={`founding-submit-${source}`}>Join the List</button>
  <p class="form-note">We respect your inbox. A couple of emails before opening, then only what's useful. Unsubscribe anytime.</p>
</form>

<style>
  .founding-form { max-width: 480px; }
  .founding-form .btn { margin-top: 6px; }
  .founding-form .form-note { margin-top: 12px; }
  /* inherit the surrounding text colour so it reads on both dark sections and white cards.
     The privacy link is kept OUTSIDE the checkbox label so clicking it never toggles the box. */
  .consent { display: flex; gap: 10px; align-items: flex-start; margin: 8px 0 2px; font-size: 13px; color: inherit; }
  .consent input { margin-top: 3px; flex-shrink: 0; }
  .consent label { cursor: pointer; }
  .consent-note { margin: 2px 0 4px 28px; font-size: 13px; color: inherit; }
  .consent-note a { color: inherit; text-decoration: underline; }
</style>
